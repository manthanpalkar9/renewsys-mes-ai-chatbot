# =============================================================================
# Renewsys MES AI Chatbot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in values before running the application.
# NEVER commit .env to version control.
#
# LLM_PROVIDER options:
#   mock   - No LLM required. Rule-based. Always works. (DEFAULT)
#   ollama - Local Ollama instance (K2 safe). Set LLM_ENDPOINT + LLM_MODEL.
#   openai - OpenAI API (⚠️ K2 WARNING: external cloud). Set OPENAI_API_KEY.
#
# OPENAI_API_KEY - NEVER hard-code. NEVER commit. Set here or as env var.
OPENAI_API_KEY=
# =============================================================================

# --- Application ---
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE-ME-generate-a-long-random-secret-key-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- MES Database (STAKEHOLDER-PROVIDED - REQUIRES TECHNICAL VERIFICATION) ---
# Host: 10.69.12.20 (stakeholder-provided; verify with IT/DBA before use)
# Port: 8000 (stakeholder-provided; verify with IT/DBA before use)
# Database engine: TBD - use MOCK_MODE=true during development
MES_DB_HOST=10.69.12.20
MES_DB_PORT=8000
MES_DB_NAME=JinchenMES
MES_DB_USER=
MES_DB_PASSWORD=
MES_DB_ENGINE=
# Set to 'mock' during development (real Jinchen MES schema not yet confirmed)
# Set to 'jinchen' when real adapter is ready
MES_ADAPTER=mock

# --- Query Safety ---
QUERY_TIMEOUT_SECONDS=30
QUERY_MAX_ROWS=10000
HISTORY_DAYS_LIMIT=30

# --- LLM Provider ---
# LLM vendor/model not yet decided (K1: 'Not decided', K3: no approved vendor)
# Data MUST stay in-network (K2: CONFIRMED requirement)
# Set to 'mock' for development without LLM
LLM_PROVIDER=mock
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# --- Timezone (L5: TBD - do not assume IST/UTC without IT confirmation) ---
TIMEZONE=TBD

# --- Shifts (L6: CONFIRMED) ---
SHIFT_A_START=07:00
SHIFT_A_END=15:00
SHIFT_B_START=15:00
SHIFT_B_END=23:00
SHIFT_C_START=23:00
SHIFT_C_END=07:00

# --- Internal Application DB (for users/sessions - NOT the MES database) ---
APP_DB_URL=sqlite:///./data/app.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
# T3 (CONFIRMED): Sensitive values must be masked in logs
LOG_MASK_SENSITIVE=true

# --- CORS (for frontend) ---
FRONTEND_URL=http://localhost:3000
